{
  "name": "site-status-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "Internal real-time status page for WordPress / Next.js sites with email alerts",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js"
  },
  "engines": { "node": ">=20.12" },
  "dependencies": {
    "nodemailer": "^6.9.16"
  }
}
