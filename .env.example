# --- Dashboard ---
PORT=3000
APP_NAME=TMJ Dashboard
# Login for the dashboard's sign-in page (strongly recommended).
# Changing DASHBOARD_PASS signs everyone out.
DASHBOARD_USER=admin
DASHBOARD_PASS=change-me
# Optional extra secret for signing login cookies
SESSION_SECRET=
# Link included in alert emails
PUBLIC_URL=https://status.internal.example.com

# --- Checks ---
CHECK_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_MS=15000
SLOW_THRESHOLD_MS=5000
# Consecutive failures before a site is marked DOWN (avoids alerts from one blip)
FAIL_THRESHOLD=2
CHECK_CONCURRENCY=10
# Send a reminder every N minutes while a site stays down (0 = off)
REALERT_MINUTES=60
SSL_WARN_DAYS=14

# --- Extra checks ---
# Health & SEO checks (robots.txt, sitemap, noindex, domain expiry, WordPress API, RSS…)
HEALTH_CHECK_HOURS=6
# How often the article page to monitor is re-discovered
ARTICLE_REFRESH_HOURS=12
# Moz Domain Authority: create a token at https://moz.com/products/api (free tier available)
MOZ_API_TOKEN=
DA_REFRESH_DAYS=7

# Secret sent as the X-Status-Monitor header on every check. Use it in a Cloudflare
# WAF "Skip" rule so bot protection doesn't block the monitor (see README).
MONITOR_TOKEN=generate-a-long-random-string

# Secret for GET /api/cron?token=… so an external cron job (e.g. Hostinger) can trigger checks.
CRON_TOKEN=generate-another-long-random-string
# Where history is stored. On Hostinger, use a folder outside the deploy dir, e.g. /home/u123456789/status-data
DATA_DIR=data

# --- Email alerts via Gmail / Google Workspace ---
# SMTP_USER is the Gmail account that sends the alerts.
# SMTP_PASS must be a 16-character App Password, not your normal password:
#   Google Account → Security → 2-Step Verification (must be ON) → App passwords
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@gmail.com
SMTP_PASS=abcdefghijklmnop
ALERT_EMAIL_FROM="Site Status Monitor <your-account@gmail.com>"
# Who receives alerts (comma-separated)
ALERT_EMAIL_TO=you@example.com
