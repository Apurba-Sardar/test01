# --- Dashboard ---
PORT=3000
# Protect the internal page with a login (strongly recommended)
DASHBOARD_USER=admin
DASHBOARD_PASS=change-me
# Link included in alert emails
PUBLIC_URL=https://status.internal.example.com

# --- Checks ---
CHECK_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_MS=15000
SLOW_THRESHOLD_MS=5000
# Consecutive failures before a site is marked DOWN (avoids alerts from one blip)
FAIL_THRESHOLD=2
CHECK_CONCURRENCY=10
# Send a reminder every N minutes while a site stays down (0 = off)
REALERT_MINUTES=60
SSL_WARN_DAYS=14

# --- Email alerts (any SMTP: Gmail, Google Workspace, SES, SendGrid, Mailgun, Zoho…) ---
# Gmail / Workspace: smtp.gmail.com, port 465, SMTP_SECURE=true, and an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=alerts@yourdomain.com
SMTP_PASS=your-app-password
ALERT_EMAIL_FROM="Status Monitor <alerts@yourdomain.com>"
# Comma-separated list of recipients
ALERT_EMAIL_TO=you@yourdomain.com
